# ─────────────────────────────────────────────────────────────────────────────
# M Rajkamal — environment template
#
#   cp .env.example .env.local
#
# .env.local IS THE ONLY ENV FILE. Do not also create a .env.
# Next resolves each variable by walking .env.local BEFORE .env and stopping at
# the first hit — so an EMPTY value in .env.local silently shadows a real one in
# .env. That bug was live in this repo (the ImageKit keys resolved to "").
# src/lib/env.ts now validates every var at boot, so a blank or missing value
# fails fast and loudly instead of failing quietly at the first upload.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev uses a local mongod. Swap for the Atlas connection string on deploy.
MONGODB_URI=mongodb://127.0.0.1:27017/mrajkamal

# ── Auth.js v5 (NextAuth) — single admin, credentials provider ───────────────
# AUTH_SECRET: 32+ chars.   Generate with:  npx auth secret
AUTH_SECRET=

ADMIN_EMAIL=admin@example.com

# ADMIN_PASSWORD_HASH: a bcrypt hash — and the '$' separators MUST be
# backslash-escaped (\$2b\$12\$...). dotenv expands a bare '$' as a variable
# reference, which eats the hash down to an empty string. Quoting does NOT
# protect it (quotes are stripped before expansion runs); only escaping does.
#
# Generate an already-escaped hash:
#   node -e "console.log(require('bcryptjs').hashSync('your-password',12).replaceAll('$','\\$'))"
ADMIN_PASSWORD_HASH=

# ── ImageKit — product & site image storage ──────────────────────────────────
# ImageKit dashboard → Developer Options → API Keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Public site ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL is load-bearing, not cosmetic: it builds the absolute
# product URL inside the WhatsApp inquiry message, plus the canonical tags, the
# OG tags and the sitemap. Set it to the real origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Digits only, full international form — no '+', no spaces. e.g. 919833533076
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Optional overrides (working public defaults are baked into the code) ─────
# BEHOLD_FEED_URL=https://feeds.behold.so/eimRGkuydD7AmFnvCBi1
# FEATURABLE_WIDGET_URL=https://featurable.com/api/v2/widgets/40ac0cc8-8e17-415d-936d-bdd303fd3b53
